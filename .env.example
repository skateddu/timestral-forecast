# Every field of timestral_forecast.config.Settings can be overridden with a TF_ variable
TF_DEVICE=cpu
TF_STORE_IDS=["CA_1", "TX_1", "WI_1"]
TF_DEPT_ID=FOODS_3
TF_N_WINDOWS=3
TF_HOLIDAY_CUTOFFS=["2015-06-21", "2015-11-22", "2015-12-20"]
TF_TIMESTRAL_MAX_CONTEXT=1024
TF_TIMESTRAL_BATCH_SIZE=64
TF_TIMESTRAL_COVARIATE_MODELS=["mistralai/Timestral-28M"]
TF_TIMESTRAL_MASK_CONSTANT_PRICE=true
TF_TIMESTRAL_SYMMETRIC_AVERAGING_WITH_COVARIATES=true
TF_TIMESTRAL_GROUP_SIZE=4
TF_N_JOBS=16
